# Prevent direct access to uploads directory
Options -Indexes

# Allow access to files (images, videos) but not directory listing
<FilesMatch "\.(jpg|jpeg|png|gif|webp|mp4|webm|ogg)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Prevent execution of PHP files in uploads directory
<FilesMatch "\.(php|php5|php7|phtml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>